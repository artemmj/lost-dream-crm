SECRET_KEY=qwe
ACCESS_TOKEN_EXPIRE=12_000_000

# service-auth использует общую БД db-crm (хост — имя сервиса в compose-сети)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_NAME=db-crm
POSTGRES_HOST=db-crm
POSTGRES_PORT=5432
POSTGRES_ECHO=False

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Должен совпадать с REDIS_PASSWORD контейнера redis (см. docker-compose.yml)
REDIS_PASSWORD=redispass